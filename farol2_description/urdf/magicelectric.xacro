<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="magicelectric">

  <!-- Constants -->
  <xacro:property name="M_PI" value="3.1415926535897931" />
  <xacro:arg name="simple_allocation" default="true" />

  <!-- Base -->
  <link name="base_link"/>

  <xacro:if value="$(arg simple_allocation)">
    <!-- Pseudo thruster (middle) -->
    <link name="thruster_middle_link"/>
    <joint name="base_to_thruster_middle" type="fixed">
      <parent link="base_link"/>
      <child link="thruster_middle_link"/>
      <origin xyz="-4.0 0.0 0.0" rpy="0 0 0"/>
    </joint>

    <!-- Pseudo rudder (middle, dynamic rotation) -->
    <link name="rudder_middle_link"/>
    <joint name="base_to_rudder_middle" type="continuous">
      <parent link="base_link"/>
      <child link="rudder_middle_link"/>
      <origin xyz="-4.5 0.0 0.0" rpy="0 0 ${1*M_PI}"/>
      <axis xyz="0 0 1"/>
    </joint>
  </xacro:if>

  <xacro:unless value="$(arg simple_allocation)">
    <!-- Thrusters and rudders -->
    <link name="thruster_left_link"/>
    <joint name="base_to_thruster_left" type="fixed">
      <parent link="base_link"/>
      <child link="thruster_left_link"/>
      <origin xyz="-4.0 -1.5 0.0" rpy="0 0 0"/>
    </joint>

    <link name="thruster_right_link"/>
    <joint name="base_to_thruster_right" type="fixed">
      <parent link="base_link"/>
      <child link="thruster_right_link"/>
      <origin xyz="-4.0 1.5 0.0" rpy="0 0 0"/>
    </joint>

    <link name="rudder_left_link"/>
    <joint name="base_to_rudder_left" type="continuous">
      <parent link="base_link"/>
      <child link="rudder_left_link"/>
      <origin xyz="-4.5 -1.5 0.0" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>

    <link name="rudder_right_link"/>
    <joint name="base_to_rudder_right" type="continuous">
      <parent link="base_link"/>
      <child link="rudder_right_link"/>
      <origin xyz="-4.5 1.5 0.0" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>
  </xacro:unless>

  <!-- Sensor frames used in the headers of the simulated measurements (farol2_sim). Placeholders at base_link with zero offset, the real mounting offsets still have to be measured. -->
  <link name="gnss_link"/>
  <joint name="base_to_gnss" type="fixed">
    <parent link="base_link"/>
    <child link="gnss_link"/>
    <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
  </joint>
  <link name="dvl_link"/>
  <joint name="base_to_dvl" type="fixed">
    <parent link="base_link"/>
    <child link="dvl_link"/>
    <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
  </joint>
  <link name="depth_link"/>
  <joint name="base_to_depth" type="fixed">
    <parent link="base_link"/>
    <child link="depth_link"/>
    <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
  </joint>
  <link name="imu_link"/>
  <joint name="base_to_imu" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
  </joint>
  <link name="rudder_link"/>
  <joint name="base_to_rudder" type="fixed">
    <parent link="base_link"/>
    <child link="rudder_link"/>
    <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
  </joint>

</robot>
