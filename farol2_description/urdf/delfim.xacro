<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mred">

  <!-- Constants -->
  <xacro:property name="M_PI" value="3.1415926535897931" />

  <!-- Base -->
  <link name="base_link"/>

  <!-- Thrusters -->
  <link name="thruster_portside_link"/>
  <joint name="base_to_thruster_portside" type="fixed">
    <parent link="base_link"/>
    <child link="thruster_portside_link"/>
    <origin xyz="-2.0 -2.00 0.0" rpy="0 0 0"/>
  </joint>

  <link name="thruster_starboard_link"/>
  <joint name="base_to_thruster_starboard" type="fixed">
    <parent link="base_link"/>
    <child link="thruster_starboard_link"/>
    <origin xyz="-2.0 2.00 0.0" rpy="0 0 0"/>
  </joint>

  <!-- Sensor frames used in the headers of the simulated measurements (farol2_sim). Placeholders at base_link with zero offset, the real mounting offsets still have to be measured. -->
  <link name="gnss_link"/>
  <joint name="base_to_gnss" type="fixed">
    <parent link="base_link"/>
    <child link="gnss_link"/>
    <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
  </joint>
  <link name="dvl_link"/>
  <joint name="base_to_dvl" type="fixed">
    <parent link="base_link"/>
    <child link="dvl_link"/>
    <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
  </joint>
  <link name="depth_link"/>
  <joint name="base_to_depth" type="fixed">
    <parent link="base_link"/>
    <child link="depth_link"/>
    <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
  </joint>
  <link name="imu_link"/>
  <joint name="base_to_imu" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
  </joint>

</robot>
