#!/usr/bin/env bash
set -euo pipefail
IFS=$'\n\t'

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=farol-common
source "$SCRIPT_DIR/farol-common"

target="${1:-farol2}"
root="$(farol_workspace_root_or_die)"

if [[ "$target" == "root" ]]; then
    printf '%s\n' "$root"
    exit 0
fi

for candidate in "$target" "farol2_$target"; do
    if [[ -d "$root/src/$candidate" ]]; then
        printf '%s\n' "$root/src/$candidate"
        exit 0
    fi
    if [[ -d "$root/src/farol2/$candidate" ]]; then
        printf '%s\n' "$root/src/farol2/$candidate"
        exit 0
    fi
done

for candidate in "$target" "farol2_$target"; do
    if path="$("$SCRIPT_DIR/farol-pkg-src" "$candidate" 2>/dev/null)"; then
        printf '%s\n' "$path"
        exit 0
    fi
done

farol_die "workspace package or folder not found: $target"
