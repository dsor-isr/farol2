<?xml version="1.0"?>
<launch>
 
 	<arg name="dollar" value="$" />
	<arg name="name"/> <!-- Name of the vehicle being launched -->   
  	<arg name="config_package_path"  /> <!-- Name of the package where the configuration files are stored -->
  	<arg name="folder"/>  <!-- Name of the folder for the configuration files -->

 <!-- small description about your node -->
 
 <node pkg="example_cpp" type="example_cpp_node" name="ExampleCppNode" respawn="false" output="screen">
	<rosparam command="load" file="$(find example_cpp)/config/config_example_cpp.yaml"/>
	<rosparam command="load" file="$(arg dollar)$(arg config_package_path))/config/$(arg folder)/$(arg name)/example_cpp.yaml"/>
</node>

</launch>