<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>farol2_bringup</name>
  <version>0.0.0</version>
  <description>farol2_bringup: configuration files and shared launch files for the Farol2 stack</description>
  <maintainer email="eduardo.m.a.cunha@tecnico.ulisboa.pt">Eduardo Cunha</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>ament_cmake_python</build_depend>
  <exec_depend>ament_cmake_python</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>ros2bag</exec_depend>
  <!-- start_farol2.launch.py includes the launch files of farol2_nav, farol2_allocation, farol2_inner_loop,
       farol2_waypoint, farol2_path_following, farol2_planning, farol2_console, farol2_description and
       farol2_sim, but these are not declared as dependencies here: the launch files of those packages
       read their configuration from this package (see farol2_allocation), and a declaration in both
       directions is a dependency cycle that colcon cannot order. -->

  <test_depend>ament_copyright</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
